<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Flake</RootNamespace>
    <AssemblyName>SnowfallStudio</AssemblyName>
    <Product>Snowfall Studio</Product>
    <AssemblyTitle>Snowfall Studio</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SnowfallStudio.Application\SnowfallStudio.Application.csproj" />
    <ProjectReference Include="..\SnowfallStudio.Core\SnowfallStudio.Core.csproj" />
    <ProjectReference Include="..\SnowfallStudio.Infrastructure\SnowfallStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\SnowfallStudio.Platform.Windows\SnowfallStudio.Platform.Windows.csproj" />
    <ProjectReference Include="..\SnowfallStudio.Rendering.Wpf\SnowfallStudio.Rendering.Wpf.csproj" />
  </ItemGroup>
</Project>
